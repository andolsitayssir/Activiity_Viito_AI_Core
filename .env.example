# Copy this file to .env and replace every <...> value with your local value.
# Never commit .env or real credentials.

# AI routing
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_TEMPERATURE=0.0
OPENROUTER_TOP_P=1.0
OPENROUTER_MAX_TOKENS=64
OPENROUTER_FREQUENCY_PENALTY=0.0
OPENROUTER_PRESENCE_PENALTY=0.0
OPENROUTER_SEED=42
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=activity-ai-engine
ROUTER_PROVIDER=openrouter

# Model roles used by validation and RAG. Defaults are also defined in server/config.py.
CLASSIFIER_MODEL=google/gemma-4-31b-it
VALIDATOR_MODEL=openai/gpt-4o-mini
RAG_ROUTER_MODEL=google/gemma-4-31b-it
SYNTHESIZER_MODEL=google/gemma-3-12b-it
FORMATTER_MODEL=google/gemma-3-12b-it
SUMMARIZATION_MODEL=qwen/qwen3-8b
REDACTION_MODEL=google/gemma-4-31b-it
SPEECH_RECOGNITION_MODEL=qwen/qwen3-asr-1.7b

# Odoo
ODOO_URL=http://localhost:8069
ODOO_DB=<odoo-database-name>
ODOO_MASTER_PASSWORD=<odoo-master-password>
ODOO_LOGIN=<odoo-login-email>
ODOO_PASSWORD=<odoo-login-password>
ODOO_ADMIN=<odoo-admin-user>

# Stalwart
STALWART_URL=http://localhost:8089
STALWART_ADMIN_EMAIL=<stalwart-admin-email>
STALWART_ADMIN_PASSWORD=<stalwart-admin-password>
STALWART_SENDER=<default-sender-address>

# Chatwoot
CHATWOOT_URL=http://localhost:3000
CHATWOOT_ACCESS_TOKEN=<chatwoot-access-token>
CHATWOOT_ACCOUNT_ID=<chatwoot-account-id>

# OnlyOffice
ONLYOFFICE_URL=http://localhost:8093
ONLYOFFICE_DS_INTERNAL_URL=http://localhost:8088
ONLYOFFICE_JWT_SECRET=<onlyoffice-jwt-secret>

# Vikunja
VIKUNJA_URL=http://localhost:3456
VIKUNJA_USERNAME=<vikunja-username>
VIKUNJA_PASSWORD=<vikunja-password>
VIKUNJA_SERVICE_SECRET=<vikunja-service-secret>
VIKUNJA_DATABASE_HOST=db
VIKUNJA_DATABASE_USER=<vikunja-database-user>
VIKUNJA_DATABASE_PASSWORD=<vikunja-database-password>
VIKUNJA_DATABASE_DATABASE=<vikunja-database-name>

# Nextcloud and Activiitykdb/RAG
NEXTCLOUD_URL=http://localhost:8092
RAG_URL=http://localhost:8787
QDRANT_URL=http://localhost:6333
RAG_COLLECTION=<rag-collection-name>

# Gmail OAuth (optional)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# Telegram (optional)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Executor feature toggles: 1/true enables a feature, 0/false disables it.
VIITO_ENABLE_GMAIL=1
VIITO_ENABLE_STALWART=0
VIITO_ENABLE_SEMANTIC_VALIDATION=1
VIITO_ENABLE_TELEGRAM=1

# Frontend
# Leave empty when the frontend is served by FastAPI. Set this for a separate Vite dev server.
VITE_API_BASE=

# Optional experiment tracking
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
